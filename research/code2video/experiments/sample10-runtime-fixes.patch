+import ast
 import subprocess
 from typing import List
 from manim import *
@@ -8,6 +10,26 @@
 from pathlib import Path
 
 
+def normalize_scene_play_calls(code):
+    """Convert eager Mobject mutations passed to play into animation builders."""
+    methods = {'scale', 'shift', 'move_to', 'rotate', 'set_color', 'set_opacity', 'to_edge', 'to_corner'}
+    class FixPlay(ast.NodeTransformer):
+        changed = False
+        def visit_Call(self, node):
+            self.generic_visit(node)
+            if isinstance(node.func, ast.Attribute) and node.func.attr == 'play':
+                for arg in node.args:
+                    if isinstance(arg, ast.Call) and isinstance(arg.func, ast.Attribute) and arg.func.attr in methods:
+                        if not any(isinstance(n, ast.Attribute) and n.attr == 'animate' for n in ast.walk(arg.func.value)):
+                            arg.func.value = ast.Attribute(value=arg.func.value, attr='animate', ctx=ast.Load())
+                            self.changed = True
+            return node
+    tree = ast.parse(code)
+    fixer = FixPlay()
+    fixer.visit(tree)
+    return ast.unparse(ast.fix_missing_locations(tree)) + '\n' if fixer.changed else code
+
+
