diff --git a/src/gpt_request.py b/src/gpt_request.py
index 1251784..5e224d7 100644
--- a/src/gpt_request.py
+++ b/src/gpt_request.py
@@ -24,6 +24,24 @@ def generate_log_id():
     return f"tkb{int(time.time() * 1000)}"
 
 
+def request_local_token(prompt, max_tokens=10000):
+    """OpenAI-compatible local inference, isolated from vendor API settings."""
+    client = OpenAI(
+        base_url=os.getenv("LOCAL_BASE_URL", "http://127.0.0.1:8000/v1"),
+        api_key=os.getenv("LOCAL_API_KEY", "local"),
+        timeout=600, max_retries=1,
+    )
+    response = client.chat.completions.create(
+        model=os.getenv("LOCAL_MODEL", "qwen3.8-27b"),
+        messages=[{"role": "user", "content": prompt}],
+        max_tokens=max_tokens, temperature=0.6,
+        extra_body={"chat_template_kwargs": {"enable_thinking": False}},
+    )
+    if response.choices[0].finish_reason == "length":
+        raise RuntimeError("Local model output truncated; increase max_tokens")
+    return response, response.usage.model_dump() if response.usage else {}
+
+
